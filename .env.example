# ============================================================
#  Paste ONE API key below — whichever provider you want to use.
#  The system auto-detects which one you filled in. Delete/ignore the rest.
# ============================================================

# SCNet (超算互联网) — GLM-5.2, cheapest, strong bilingual EN/ZH
# Base URL: https://api.scnet.cn/api/llm/v1
SCNET_API_KEY=

# Kimi K2.5 (Moonshot)
MOONSHOT_API_KEY=

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# GPT (OpenAI)
OPENAI_API_KEY=


# ---- Everything below is OPTIONAL — leave blank unless you need it ----

# X / Twitter: only for the FIRST local login to generate cookies.json.
# After that you use cookies.json (or the X_COOKIES_JSON GitHub secret) and
# these are never read again. Leave blank if you disabled X in config.yaml.
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# Compressed push notification webhook (slack|discord|telegram|feishu|plain).
# If blank, the notify step just prints a preview instead of sending.
NOTIFY_WEBHOOK_URL=
